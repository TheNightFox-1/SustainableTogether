        <mxCell id="title" value="Phase deliverables flow — what each phase produces, what the next consumes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry" />
        </mxCell>

        <!-- Phase nodes (left column) -->
        <mxCell id="P1" value="Phase 1&#10;Frame ambition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=6" vertex="1" parent="1">

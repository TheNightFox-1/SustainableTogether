        </mxCell>

        <!-- Deliverables column -->
        <mxCell id="d1" value="• Ambition Statement (six-capital target table)&#10;• Time horizons per capital&#10;• Reference / comparator per target&#10;• Triple Top Line aggregation justification&#10;• Governance commitments (FPIC, CARE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="• Story of Place dossier (geology, hydrology, biota, climate, history, Indigenous knowledge, socio-economy)&#10;• Bioregional GIS map&#10;• Stakeholder + knowledge-holder register&#10;• Conventional site-assessment sub-report&#10;• Climate-projection memo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="• Local Doughnut report (12 social + 9 ecological)&#10;• Baseline LCA report (ISO 14040/14044, IEA PVPS T12)&#10;• Baseline ecological/social monitoring data&#10;• Counterfactual specification&#10;• Phase 1 reconciliation note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6" vertex="1" parent="1">

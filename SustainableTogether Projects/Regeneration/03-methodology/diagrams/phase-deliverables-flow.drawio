        </mxCell>
        <mxCell id="d4" value="• Populated 8×6 lifecycle×capital matrix&#10;• Mechanism-activation map (M1–M5)&#10;• Gap log (cells without regen vector)&#10;• Crosswalk to ESPR/WEEE/Taxonomy criteria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="• Solution-instantiated matrix (cells reference taxonomy IDs)&#10;• Per-cell quantitative target deltas with baseline pairings&#10;• Risk register (overclaiming, climate-trajectory)&#10;• Indigenous-knowledge attribution where relevant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="320" y="560" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="• Coherent design specification (cross-phase consistency check)&#10;• Identified SysML v2 hooks (deferred to a later pass)&#10;• Identified openLCA hooks (Hamza's Stage 1–3 pipeline)&#10;• Synthesis dossier hand-off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6" vertex="1" parent="1">

        <mxCell id="n5" value="GENERIC LOOPS (archetypes, use-case free)&#xa;R1 Value engagement engine: base → throughput → co-creation → need satisfaction → relationship → engagement → base&#xa;B1 Actor pool saturation: base −→ pool → engagement → base&#xa;R2 Capability reinvestment: base → resources → capacity → quality → satisfaction → ... → base&#xa;B2 Service overload: throughput −→ quality → satisfaction → ... → base → throughput&#xa;B3 Co-destruction drag: throughput → co-destruction −→ satisfaction → ... → throughput&#xa;B4 Ecological source limit: throughput → extraction −→ biophysical stock → ecosystem services → capacity → ... → throughput&#xa;R3 Regenerative reinvestment: resources → regeneration → biophysical stock → ecosystem services → capacity → ... → resources&#xa;B5 Governance goal-seeking: benefits −→ goal gap → governance → capacity/regeneration → ... → benefits&#xa;R4 Legitimacy: benefits → societal legitimacy → engagement → base → ... → benefits" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="LEGEND (variable colour = source FBMC block group)&#xa;BLUE = People (Actors, Stakeholders, Needs, Relationships, Channels)&#xa;AMBER = Value (Co-Creations, Co-Destructions, Products/Services)&#xa;PURPLE = Process (Resources, Activities, Partnerships)&#xa;GREEN = Environment (Biophysical Stocks, Ecosystem Services, Society context)&#xa;DARK RED = Outcomes &amp; Governance (Costs, Benefits, Goals, Governance)&#xa;[Block • sdTypeHint] shown under each variable. Every FBMC block of the canvas is represented — coverage invariant I2 satisfied by construction." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="120" width="380" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

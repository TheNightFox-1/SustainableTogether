        <mxCell id="sd-sde" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=center;fontStyle=1" value="SDVariable (Vensim)" vertex="1">
          <mxGeometry height="40" width="230" x="667" y="378" as="geometry" />
        </mxCell>
        <mxCell id="sd-e7" edge="1" parent="1" source="sd-sv" style="html=1;endArrow=block;endFill=0;strokeColor=#666666;fontSize=11" target="sd-ma" value="realizes (0..1)">
          <mxGeometry relative="1" as="geometry" />

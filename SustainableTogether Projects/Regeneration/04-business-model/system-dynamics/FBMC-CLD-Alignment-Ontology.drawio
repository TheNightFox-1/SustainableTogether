        <mxCell id="sd-e8" edge="1" parent="1" source="sd-sde" style="html=1;endArrow=block;endFill=0;strokeColor=#666666;fontSize=11" target="sd-ma" value="sdImplements (0..1)">
          <mxGeometry relative="1" as="geometry" />

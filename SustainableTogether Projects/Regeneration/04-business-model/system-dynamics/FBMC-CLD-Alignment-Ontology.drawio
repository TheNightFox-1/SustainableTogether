        <mxCell id="sd-e6" edge="1" parent="1" source="sd-aux" style="html=1;endArrow=block;endFill=0;strokeColor=#666666;fontSize=11;dashed=1" target="sd-rate" value="informs (information link)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

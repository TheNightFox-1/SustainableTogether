        <mxCell id="v1" value="engaged stakeholder base&#xa;[Stakeholders • Stock]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#3b6ba5;" vertex="1" parent="1">

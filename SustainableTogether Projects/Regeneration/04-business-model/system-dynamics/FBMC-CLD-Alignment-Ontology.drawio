          <mxGeometry height="100" width="230" x="850" y="80" as="geometry" />
        </mxCell>
        <mxCell id="sd-sv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=center;fontStyle=1" value="SystemVariable (CLD)" vertex="1">
          <mxGeometry height="40" width="230" x="912" y="280" as="geometry" />

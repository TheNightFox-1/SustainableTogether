        <mxCell id="v1" value="engaged stakeholder base&#xa;[Stakeholders &#8226; Stock]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#3b6ba5;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="v2" value="engagement rate&#xa;[Channels &#8226; Flow]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#3b6ba5;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="v3" value="remaining addressable actor pool&#xa;[Actors+Needs &#8226; Stock]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#3b6ba5;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="v4" value="relationship strength and trust&#xa;[Relationships &#8226; Stock]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#3b6ba5;" vertex="1" parent="1"><mxGeometry x="260" y="390" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="v5" value="need satisfaction level&#xa;[Needs &#8226; Auxiliary]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#3b6ba5;" vertex="1" parent="1"><mxGeometry x="470" y="490" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="v6" value="societal legitimacy&#xa;[Society context &#8226; Auxiliary]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#4d784e;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="160" height="40" as="geometry" /></mxCell>

        <mxCell id="v7" value="value co-creation rate&#xa;[Value Co-Creations &#8226; Flow]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#b26b00;" vertex="1" parent="1"><mxGeometry x="690" y="450" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="v8" value="value co-destruction rate&#xa;[Value Co-Destructions &#8226; Flow]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#b26b00;" vertex="1" parent="1"><mxGeometry x="880" y="620" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="v9" value="offering delivery quality&#xa;[Products/Services &#8226; Auxiliary]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#b26b00;" vertex="1" parent="1"><mxGeometry x="680" y="580" width="180" height="40" as="geometry" /></mxCell>


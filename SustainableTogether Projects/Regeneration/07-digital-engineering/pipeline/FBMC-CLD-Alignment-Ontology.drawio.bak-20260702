        <mxCell id="b2f2" value="+ canonicalName: single concept, direction-neutral" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b2"><mxGeometry y="46" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b2f3" value="+ definition: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b2"><mxGeometry y="66" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b2f4" value="+ unit: String (mandatory before SD stage)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b2"><mxGeometry y="86" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b2f5" value="+ dimension: Econ | Soc | Eco" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b2"><mxGeometry y="106" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b2f6" value="+ sdTypeHint: Stock | Flow | Auxiliary | Parameter" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b2"><mxGeometry y="126" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b2f7" value="+ inCldBoundary: Boolean (+ exclusion rationale)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b2"><mxGeometry y="146" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b2f8" value="+ version: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b2"><mxGeometry y="166" width="300" height="20" as="geometry" /></mxCell>

        <mxCell id="b3" value="ChangeRecord" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;rounded=0;shadow=0;strokeWidth=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="620" y="540" width="300" height="106" as="geometry" />
        </mxCell>
        <mxCell id="b3f1" value="+ date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b3"><mxGeometry y="26" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b3f2" value="+ changeType: add | rename | split | merge | retire" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b3"><mxGeometry y="46" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b3f3" value="+ rationale: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b3"><mxGeometry y="66" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b3f4" value="+ affectedArtifacts: [FBMC, CLD, SD, Excel]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="b3"><mxGeometry y="86" width="300" height="20" as="geometry" /></mxCell>

        <mxCell id="y1" value="SystemVariable&#xa;(CLD node)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1180" y="300" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="y2" value="Vensim SD model (stage 2)&#xa;Level / Rate / Auxiliary / Constant&#xa;from sdTypeHint + unit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="480" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="y3" value="Excel financial model (stage 3)&#xa;line items bind to Econ attributes;&#xa;KPI rows bind to Indicators" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="600" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="is attribute of &#9656; exactly 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;exitX=0;exitY=0.25;entryX=1;entryY=0.5;fontSize=11;fontStyle=1;" edge="1" parent="1" source="b2" target="x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="&#171;applies&#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="* records changes to 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=11;" edge="1" parent="1" source="b3" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="&#171;must map to&#187; 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;fontSize=11;" edge="1" parent="1" source="x2" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="realizes &#9656; exactly 1 (via sourceAttributeId)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;fontStyle=1;" edge="1" parent="1" source="y1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="&#171;derives&#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="y1" target="y2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="&#171;binds&#187;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="y2" target="y3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n1" value="INFORMATION FLOW  FBMC &#8594; CLD (FBMC is the starting point)&#xa;1. Enumerate FBMC elements zone by zone.&#xa;2. For each element ask: which measurable attribute of it varies over time and matters to the problem? (Elements do not vary &#8212; their attributes do. &#8220;Financier&#8221; is an Actor; &#8220;financier confidence&#8221; is one of its attributes.)&#xa;3. Register the attribute: canonical name, definition, unit, dimension, sdTypeHint (via DerivationRule).&#xa;4. Decide inCldBoundary per attribute; record exclusion rationale.&#xa;5. Generate CLD variables 1:1 from in-boundary attributes &#8212; never free-typed.&#xa;6. Draw causal links only between registered variables; derive loop types.&#xa;7. Validate invariants (right) before publishing a CLD version." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="SYNCHRONIZATION INVARIANTS (check on every change)&#xa;I1. Every SystemVariable realizes exactly one MeasurableAttribute; every attribute anchors to exactly one FBMCElement &#8594; full trace: CLD variable &#8594; attribute &#8594; canvas element.&#xa;I2. Coverage: every FBMC element has &#8805;1 attribute in the CLD or an explicit out-of-boundary rationale.&#xa;I3. loopType is derived (B iff odd # of &#8722; links) &#8212; catches v2&#8217;s mislabelled R7.&#xa;I4. One concept per variable; direction-neutral names.&#xa;I5. Actual vs. perceived state are separate attributes (environmental benefit &#8800; environmental reputation).&#xa;I6. Every Goal/Indicator maps to an attribute present in the CLD, so the model can report tri-profit (Econ, Soc, Eco).&#xa;I7. Renames/splits/merges only via ChangeRecord in the registry; FBMC and CLD are regenerated from it, never edited independently &#8212; this prevents the silent v1&#8594;v2 vocabulary drift." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="680" width="480" height="290" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="GENERAL PATTERN (any two domains)&#xa;Hub-and-spoke: each domain maps once to the shared registry instead of pairwise domain-to-domain mappings. Adding SD and Excel later reuses the same bridge &#8212; no new FBMC&#8594;SD or CLD&#8594;Excel mappings needed." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="680" width="360" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-generic-cld" name="4 - Generic CLD from complete FBMC">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t4" value="Generic CLD derived from the COMPLETE FBMC &#8212; one variable per canvas block, no use case. Colours = source FBMC block group (legend below). Instantiation = renaming these variables for a concrete business (e.g. PV), never inventing unanchored ones." style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1500" height="45" as="geometry" />

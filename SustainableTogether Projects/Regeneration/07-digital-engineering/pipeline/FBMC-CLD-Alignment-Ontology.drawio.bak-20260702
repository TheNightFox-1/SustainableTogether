        <mxCell id="c3f4" value="+ sourceFbmcRelation (optional trace)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c3"><mxGeometry y="86" width="280" height="20" as="geometry" /></mxCell>

        <mxCell id="c4" value="FeedbackLoop" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;rounded=0;shadow=0;strokeWidth=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="450" width="280" height="106" as="geometry" />
        </mxCell>
        <mxCell id="c4f1" value="+ loopId: String (stable across versions)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c4"><mxGeometry y="26" width="280" height="20" as="geometry" /></mxCell>
        <mxCell id="c4f2" value="+ loopType: R | B &#8212; DERIVED, never asserted" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c4"><mxGeometry y="46" width="280" height="20" as="geometry" /></mxCell>
        <mxCell id="c4f3" value="+ loopName: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c4"><mxGeometry y="66" width="280" height="20" as="geometry" /></mxCell>
        <mxCell id="c4f4" value="+ narrative: String (causation chain text)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="c4"><mxGeometry y="86" width="280" height="20" as="geometry" /></mxCell>

        <mxCell id="e14" value="contains *" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="contains *" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;exitX=1;exitY=0.5;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="from 1 / to 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="ordered set of 2..* links (closed walk)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=11;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n2a" value="WELL-FORMEDNESS RULES (these catch the v1/v2 defects)&#xa;W1. One concept per variable &#8212; no compounds (&#8220;financier confidence and ROI confidence&#8221; is invalid).&#xa;W2. Direction-neutral noun phrases &#8212; no &#8220;gain&#8221;, &#8220;reduction&#8221;, &#8220;pressure increase&#8221; baked into names; direction lives in link polarity.&#xa;W3. loopType = B iff odd number of &#8722; links in the loop, else R (v2&#8217;s R7 fails this: it is balancing).&#xa;W4. Every variable must in principle be quantifiable (a unit can be stated) &#8212; required for the Vensim stage.&#xa;W5. Actual state and perceived state are different variables (environmental benefit &#8800; environmental reputation).&#xa;W6. Loop IDs are stable: merging/splitting loops requires a ChangeRecord, not silent renumbering." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="430" width="440" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>


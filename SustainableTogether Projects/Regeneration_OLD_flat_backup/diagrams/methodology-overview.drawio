<mxfile host="app.diagrams.net" type="device">
  <diagram name="Methodology Overview" id="methodology-overview">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Regenerative PV — 8-phase Methodology" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="40" as="geometry" />
        </mxCell>

        <!-- Macro-phase A: Set Context -->
        <mxCell id="macroA" value="A · Set Context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;verticalAlign=top;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="480" height="640" as="geometry" />
        </mxCell>

        <!-- Phase 1 -->
        <mxCell id="p1" value="&lt;b&gt;Phase 1 · Frame ambition&lt;/b&gt;&lt;br&gt;Triple Top Line + 6 capitals&lt;br&gt;&lt;i&gt;→ Ambition Statement&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="400" height="80" as="geometry" />
        </mxCell>

        <!-- Phase 2 -->
        <mxCell id="p2" value="&lt;b&gt;Phase 2 · Read the place&lt;/b&gt;&lt;br&gt;Story of Place (Regenesis) + bioregional + climate + Indigenous knowledge&lt;br&gt;&lt;i&gt;→ Story of Place dossier&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Phase 3 -->
        <mxCell id="p3" value="&lt;b&gt;Phase 3 · Diagnose state&lt;/b&gt;&lt;br&gt;Local Doughnut + ISO 14040/44 baseline LCA + ecological/social baseline&lt;br&gt;&lt;i&gt;→ Doughnut + LCA + baseline data&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Macro-phase B: Design -->
        <mxCell id="macroB" value="B · Design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="480" height="640" as="geometry" />
        </mxCell>

        <!-- Phase 4 -->
        <mxCell id="p4" value="&lt;b&gt;Phase 4 · Map lifecycle&lt;/b&gt;&lt;br&gt;8 lifecycle stages × 6 capitals matrix&lt;br&gt;degeneration / regeneration vectors&lt;br&gt;&lt;i&gt;→ Populated 8×6 matrix&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Phase 5 -->
        <mxCell id="p5" value="&lt;b&gt;Phase 5 · Pick solutions&lt;/b&gt;&lt;br&gt;Populate matrix from 144-solution catalogue using mechanisms M1–M5&lt;br&gt;&lt;i&gt;→ Solution-instantiated matrix&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Phase 6 -->
        <mxCell id="p6" value="&lt;b&gt;Phase 6 · Synthesize&lt;/b&gt;&lt;br&gt;Cross-phase coherence + SysML v2 hooks (deferred to later pass) + openLCA hooks&lt;br&gt;&lt;i&gt;→ Design specification&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="600" y="440" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Macro-phase C: Realise and Learn -->
        <mxCell id="macroC" value="C · Realise &amp; Learn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="1080" y="100" width="480" height="640" as="geometry" />
        </mxCell>

        <!-- Phase 7 -->
        <mxCell id="p7" value="&lt;b&gt;Phase 7 · Business model&lt;/b&gt;&lt;br&gt;Performance Economy + EMF circular archetypes + EU Taxonomy/CSRD + ReFi caution&lt;br&gt;&lt;i&gt;→ Business &amp; governance plan&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="1120" y="220" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Phase 8 -->
        <mxCell id="p8" value="&lt;b&gt;Phase 8 · Implement &amp; learn&lt;/b&gt;&lt;br&gt;Citizen-grade MRV + adaptive management + living-lab posture&lt;br&gt;&lt;i&gt;→ MRV reports → feedback to P1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;arcSize=6" vertex="1" parent="1">
          <mxGeometry x="1120" y="400" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Sequential arrows -->
        <mxCell id="a12" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a23" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a34" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a45" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="p4" target="p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a56" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="p5" target="p6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a67" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="p6" target="p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a78" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="p7" target="p8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Feedback arrow Phase 8 -> Phase 1 -->
        <mxCell id="feedback" value="learning loop" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#B85450;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;curved=1;fontSize=11;fontColor=#B85450;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p8" target="p1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1320" y="800" />
              <mxPoint x="280" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend: Sequential flow (solid) — first-pass execution.&#10;Dashed feedback (red) — Phase 8 outputs revise Phase 1 ambition each cycle." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1520" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

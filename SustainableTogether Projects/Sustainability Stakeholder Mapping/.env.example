# SysML v2 REST API Configuration
# Copy this file to .env and fill in your values

# SysML v2 REST API base URL (usually https://api.sysml.omg.org)
SYSML_API_BASE_URL=https://api.sysml.omg.org

# Project UUID from your SysML v2 workspace
# Find this in your SysML workspace settings or API explorer
SYSML_PROJECT_ID=<your-project-uuid-here>

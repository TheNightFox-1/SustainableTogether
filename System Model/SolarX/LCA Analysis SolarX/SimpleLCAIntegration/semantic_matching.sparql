# ─────────────────────────────────────────────────────────────────────────────
# SPARQL Query: Semantic Matching of SysML v2 Material Attributes to ELCD Flows
#
# Purpose:
#   Given a SysML v2 part with material and mass attributes, find the
#   semantically matching flow in the ELCD database — without hardcoding
#   a UUID. The match is resolved by reasoning over material names and
#   the ELCD flow taxonomy.
#
# Graph inputs required:
#   - motor_lca_ontology.ttl  (ontology + bridge rules)
#   - motor_instance.ttl      (SysML v2 part as RDF individuals)
#   - elcd_flows.ttl          (ELCD flows loaded as RDF — generated by Stage 4)
#
# Usage (with rdflib in Python):
#   See stage4_integration.py
# ─────────────────────────────────────────────────────────────────────────────

PREFIX sysml: <http://sysmlv2.org/ontology#>
PREFIX lca:   <http://lca.org/ontology#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

SELECT ?partName ?materialName ?massValue ?matchedFlowName ?flowCategory ?elcdUUID
WHERE {
    # ── SysML v2 side ──
    # Get the part and its material + mass attributes
    ?part a sysml:PartDefinition ;
          rdfs:label ?partName ;
          sysml:hasAttribute ?matAttr ;
          sysml:hasAttribute ?massAttr .

    ?matAttr a sysml:MaterialAttribute ;
             sysml:materialName ?materialName .

    ?massAttr a sysml:MassAttribute ;
              sysml:massValue ?massValue .

    # ── LCA / ELCD side ──
    # Find a flow whose name semantically matches the material name.
    # No UUID is hardcoded — the match is resolved at runtime over
    # the loaded ELCD flow graph.
    ?matchedFlow a lca:Flow ;
                 lca:flowName ?matchedFlowName ;
                 lca:flowCategory ?flowCategory ;
                 lca:elcdUUID ?elcdUUID .

    # Semantic matching rule:
    # The ELCD flow name must contain the SysML material name string
    # (case-insensitive). This is the simplest form of semantic matching.
    # Stage 4 can extend this with synonym resolution or category filtering.
    FILTER(CONTAINS(LCASE(str(?matchedFlowName)), LCASE(str(?materialName))))
}
ORDER BY ?partName ?matchedFlowName
